{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XBTry",
  "mainBinaryName": "XBTry",
  "version": "1.1.2",
  "identifier": "com.xbtry.switch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "XBTry",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; script-src 'self' 'sha256-0+OrG2F/cs20PfdhaA+Ag/YCpj/hrvMU6rKXWOJlvz0='; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "xbtry"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNTRENjM4RkY0QUVFQjEKUldTeDdrci9PTlpVSVVheXdPMUFIbHMrcVZiazRsVVZiWEpUdGJaUWhDOHlYd1U0SExISE5BWDMK",
      "endpoints": [
        "https://github.com/xbtry/xbtry-switch/releases/latest/download/latest.json"
      ]
    }
  }
}
